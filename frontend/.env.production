# Production build — served by the backend at the site root.
# Polling tuned for EC2 with ~20 concurrent users.
# PUBLIC_URL must stay root-absolute. A relative value (.) makes
# /web-form/:id request /web-form/static/* and the form bundle 404s.

PUBLIC_URL=/

REACT_APP_POLL_STUDENTS_MS=30000
REACT_APP_POLL_TASKS_MS=30000
REACT_APP_POLL_INVOICES_MS=30000
REACT_APP_POLL_CHATS_MS=15000
REACT_APP_POLL_WHATSAPP_MS=15000
REACT_APP_POLL_REQUESTED_STUDENTS_MS=30000
REACT_APP_POLL_APPOINTMENTS_MS=30000
REACT_APP_POLL_BRANCH_ANALYTICS_MS=60000
REACT_APP_SLA_CLOCK_MS=30000
